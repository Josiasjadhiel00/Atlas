rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para usuarios y sus datos personales
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /history/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /memories/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /custom_apps/{appId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /custom_functions/{functionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // SEGURIDAD: antes esta colección era pública total (allow read, write:
    // if true) — cualquiera con internet, sin iniciar sesión, podía leer o
    // escribir aquí. Ahora al menos exige estar autenticado con Firebase
    // Auth. Si tus documentos de sync_devices guardan datos de un usuario
    // en particular, lo ideal es además comparar un campo ownerUid contra
    // request.auth.uid (no puedo inferir ese campo desde aquí sin ver cómo
    // los escribe tu cliente).
    match /sync_devices/{deviceId} {
      allow read, write: if request.auth != null;
    }

    // Regla de verificación de conectividad
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
