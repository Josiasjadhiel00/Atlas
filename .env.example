# OPENAI_API_KEY: OpenAI or Groq API Key (supports sk-... or gsk_...)
OPENAI_API_KEY=

# OPENAI_BASE_URL: Custom OpenAI-compatible base URL (e.g., https://api.groq.com/openai/v1 or https://api.openai.com/v1)
OPENAI_BASE_URL=

# GROQ_API_KEY: Groq Cloud API key for ultra-fast low-latency inference
GROQ_API_KEY=

# GEMINI_API_KEY: Optional Gemini AI API key.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OLLAMA_BASE_URL: Local Ollama endpoint (defaults to http://127.0.0.1:11434)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# ATLAS_BRIDGE_TOKEN: secreto compartido entre server.ts y local_bridge.py/js.
# Si lo dejas vacío, el bridge genera uno temporal al arrancar y lo imprime
# en consola — cópialo aquí y reinicia ambos procesos. Sin este token
# coincidiendo en ambos lados, server.ts no podrá hablar con el bridge.
ATLAS_BRIDGE_TOKEN=

# ATLAS_APP_ORIGIN: origen exacto desde el que corre tu app (para que el
# bridge solo acepte peticiones CORS de tu propia interfaz, no de cualquier
# página web). Ajusta el puerto si usas otro.
ATLAS_APP_ORIGIN="http://localhost:3000"

# ATLAS_SAFE_DELETE_ROOT: única carpeta dentro de la cual Atlas puede mover
# archivos a la papelera al confirmar un borrado. Por defecto tu Escritorio.
# Cualquier ruta fuera de aquí se rechaza, sin importar lo que pida la IA.
ATLAS_SAFE_DELETE_ROOT=

# ATLAS_ACCESS_PASSWORD: la contraseña para entrar a Atlas. Sin esto, NADIE
# puede iniciar sesión y toda la API queda bloqueada a propósito — antes no
# existía ningún login y cualquiera que llegara al servidor podía controlar
# tu equipo. Ponle algo largo y único, no una palabra cualquiera.
ATLAS_ACCESS_PASSWORD=

# ATLAS_SESSION_SECRET: clave con la que se firman las sesiones (cookies)
# tras iniciar sesión. Si la dejas vacía se genera una temporal al arrancar,
# pero entonces todos tendrán que volver a iniciar sesión cada vez que
# reinicies el servidor. Genera una fija con: openssl rand -hex 32
ATLAS_SESSION_SECRET=

# ATLAS_TTS_DEFAULT_VOICE: voz neuronal de edge-tts que usa Atlas cuando no
# has elegido otra en Ajustes. No necesita API key (usa el servicio de voz
# de Microsoft Edge). Ejemplos: es-MX-JorgeNeural, es-ES-AlvaroNeural,
# es-US-AlonsoNeural, es-DO-EmilioNeural, es-MX-DaliaNeural.
ATLAS_TTS_DEFAULT_VOICE="es-MX-JorgeNeural"
